{
  "name": "api",
  "version": "1.0.0",
  "description": "Product CRUD API using Node.js, Express, Sequelize, AWS RDS SQL Server and S3",
  "main": "src/server.js",
  "scripts": {
    "start": "npm run start:dev",

    "start:dev": "node scripts/start-environment.js",
    "start:sit": "node scripts/start-environment.js",
    "start:uat": "node scripts/start-environment.js",

    "db:create:dev": "node scripts/create-database.js",
    "db:create:sit": "node scripts/create-database.js",
    "db:create:uat": "node scripts/create-database.js",

    "db:migrate:dev": "npx sequelize-cli db:migrate",
    "db:migrate:sit": "npx sequelize-cli db:migrate",
    "db:migrate:uat": "npx sequelize-cli db:migrate",

    "db:undo:dev": "npx sequelize-cli db:migrate:undo",
    "db:undo:sit": "npx sequelize-cli db:migrate:undo",
    "db:undo:uat": "npx sequelize-cli db:migrate:undo",

    "dev": "nodemon src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "multer": "^2.4.0",
    "sequelize": "^6.37.8",
    "tedious": "^20.3.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
