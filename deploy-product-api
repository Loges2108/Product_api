
#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 2 ]]; then
  echo "Usage: $0 <DEV|SIT|UAT> <workspace>" >&2
  exit 1
fi

ENV_NAME="${1^^}"
WORKSPACE="$(realpath "$2")"
APP_ROOT="/var/www/product-api"
NODE_BIN="/home/ec2-user/.nvm/versions/node/v22.13.0/bin"
RUN_AS_EC2="/usr/sbin/runuser"

case "$ENV_NAME" in
  DEV) PORT=5001 ;;
  SIT) PORT=5002 ;;
  UAT) PORT=5003 ;;
  *)
    echo "Unsupported environment: $ENV_NAME" >&2
    exit 1
    ;;
esac

ENV_LOWER="${ENV_NAME,,}"
APP_DIR="$APP_ROOT/$ENV_LOWER"
ENV_FILE="$APP_ROOT/.env.$ENV_LOWER"
PM2_NAME="product-api-$ENV_LOWER"

if [[ ! -d "$WORKSPACE" || ! -f "$WORKSPACE/package.json" ]]; then
  echo "Invalid Jenkins workspace: $WORKSPACE" >&2
  exit 1
fi

for file in \
  package-lock.json \
  scripts/create-database.js \
  .sequelizerc \
  ecosystem.config.js \
  src/server.js
do
  if [[ ! -f "$WORKSPACE/$file" ]]; then
    echo "Required source file missing: $WORKSPACE/$file" >&2
    exit 1
  fi
done

if [[ ! -f "$ENV_FILE" || ! -r "$ENV_FILE" ]]; then
  echo "Environment file missing or unreadable: $ENV_FILE" >&2
  exit 1
fi

if [[ ! -x "$RUN_AS_EC2" ||
      ! -x "$NODE_BIN/node" ||
      ! -x "$NODE_BIN/npm" ]]; then
  echo "runuser or Node.js installation is missing." >&2
  exit 1
fi

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Run this deployment helper through sudo." >&2
  exit 1
fi

id ec2-user >/dev/null 2>&1 || {
  echo "ec2-user account does not exist." >&2
  exit 1
}

echo "==> Deploying $ENV_NAME API"
echo "==> Source: $WORKSPACE"
echo "==> Target: $APP_DIR"
echo "==> Database: CrudDB_$ENV_NAME"
echo "==> Port: $PORT"

install -d -o ec2-user -g ec2-user "$APP_DIR"

# Copy the selected Git branch. Preserve secrets and installed modules.
rsync -a --delete \
  --exclude='.git/' \
  --exclude='node_modules/' \
  --exclude='.env' \
  --exclude='.env.*' \
  "$WORKSPACE/" "$APP_DIR/"

chown -R ec2-user:ec2-user "$APP_DIR"

# Ensure the destination contains the expected application files.
test -f "$APP_DIR/package.json"
test -f "$APP_DIR/package-lock.json"
test -f "$APP_DIR/ecosystem.config.js"

# Install dependencies in the deployed application directory.
echo "==> Installing dependencies"
"$RUN_AS_EC2" -u ec2-user -- env \
  HOME=/home/ec2-user \
  PATH="$NODE_BIN:/usr/local/bin:/usr/bin:/bin" \
  bash -c 'cd "$1" && npm ci --no-audit --no-fund' \
  _ "$APP_DIR"

# Run database creation and migrations against the chosen environment.
# ENV_FILE is absolute and points outside the deployed source directory.
echo "==> Checking database"
"$RUN_AS_EC2" -u ec2-user -- env \
  HOME=/home/ec2-user \
  PATH="$NODE_BIN:/usr/local/bin:/usr/bin:/bin" \
  ENV_FILE="$ENV_FILE" \
  APP_ENV="$ENV_NAME" \
  NODE_ENV=production \
  PORT="$PORT" \
  bash -c 'cd "$1" && node scripts/create-database.js' \
  _ "$APP_DIR"

echo "==> Applying pending migrations"
"$RUN_AS_EC2" -u ec2-user -- env \
  HOME=/home/ec2-user \
  PATH="$NODE_BIN:/usr/local/bin:/usr/bin:/bin" \
  ENV_FILE="$ENV_FILE" \
  APP_ENV="$ENV_NAME" \
  NODE_ENV=production \
  PORT="$PORT" \
  bash -c 'cd "$1" && npx sequelize-cli db:migrate' \
  _ "$APP_DIR"

# Restart only after migrations succeed.
echo "==> Restarting $PM2_NAME"
"$RUN_AS_EC2" -u ec2-user -- env \
  HOME=/home/ec2-user \
  PATH="$NODE_BIN:/usr/local/bin:/usr/bin:/bin" \
  ENV_FILE="$ENV_FILE" \
  APP_ENV="$ENV_NAME" \
  NODE_ENV=production \
  PORT="$PORT" \
  bash -c '
    cd "$1"
    if ! command -v pm2 >/dev/null 2>&1; then
      echo "PM2 is not available to ec2-user" >&2
      exit 1
    fi
    if pm2 show "$2" >/dev/null 2>&1; then
      pm2 restart "$2" --update-env
    else
      pm2 start ecosystem.config.js --only "$2" --update-env
    fi
    pm2 save
  ' _ "$APP_DIR" "$PM2_NAME"

# Confirm that the API is responding.
echo "==> Checking health on port $PORT"
HEALTH_OK=0

for attempt in $(seq 1 20); do
  if curl --fail --silent \
    "http://127.0.0.1:$PORT/health" >/dev/null; then
    HEALTH_OK=1
    break
  fi
  echo "Health check $attempt/20 failed; retrying..."
  sleep 3
done

if [[ "$HEALTH_OK" -ne 1 ]]; then
  echo "API health check failed for $ENV_NAME." >&2
  "$RUN_AS_EC2" -u ec2-user -- env \
    HOME=/home/ec2-user \
    PATH="$NODE_BIN:/usr/local/bin:/usr/bin:/bin" \
    pm2 logs "$PM2_NAME" --lines 80 --nostream || true
  exit 1
fi

curl --fail --silent --show-error \
  "http://127.0.0.1:$PORT/api/products" >/dev/null

echo "==> Deployment successful for $ENV_NAME"
