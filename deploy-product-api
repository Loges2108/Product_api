#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  echo "Usage: $0 <DEV|SIT|UAT> <workspace>" >&2
}

if [[ $# -ne 2 ]]; then
  usage
  exit 1
fi

ENV_NAME="${1^^}"
WORKSPACE="${2}"

case "${ENV_NAME}" in
  DEV|SIT|UAT)
    ;;
  *)
    echo "Unsupported environment: ${ENV_NAME}" >&2
    exit 1
    ;;
 esac

if [[ -z "${WORKSPACE}" || ! -d "${WORKSPACE}" ]]; then
  echo "Workspace directory not found: ${WORKSPACE}" >&2
  exit 1
fi

APP_ROOT="/var/www/product-api"
APP_DIR="${APP_ROOT}/${ENV_NAME,,}"
ENV_FILE="${APP_ROOT}/.env.${ENV_NAME,,}"
DB_NAME="CrudDB_${ENV_NAME}"
PM2_NAME="product-api-${ENV_NAME,,}"
PORT="${PORT_MAP:-}"

case "${ENV_NAME}" in
  DEV) PORT=5001 ;;
  SIT) PORT=5002 ;;
  UAT) PORT=5003 ;;
 esac

if [[ ! -f "${ENV_FILE}" ]]; then
  echo "Environment file is missing: ${ENV_FILE}" >&2
  exit 1
fi

if [[ ! -f "${WORKSPACE}/package.json" ]]; then
  echo "package.json not found in workspace: ${WORKSPACE}" >&2
  exit 1
fi

if [[ ! -d "${APP_DIR}" ]]; then
  mkdir -p "${APP_DIR}"
fi

if ! id -u "ec2-user" >/dev/null 2>&1; then
  CHOWN_USER="$(id -un)"
  CHOWN_GROUP="$(id -gn)"
else
  CHOWN_USER="ec2-user"
  CHOWN_GROUP="ec2-user"
fi

if [[ "$(id -u)" -eq 0 ]]; then
  chown -R "${CHOWN_USER}:${CHOWN_GROUP}" "${APP_DIR}"
fi

cd "${WORKSPACE}"

echo "==> Installing backend dependencies"
npm ci --no-audit --no-fund

echo "==> Loading environment: ${ENV_FILE}"
export ENV_FILE="${ENV_FILE}"
export APP_ENV="${ENV_NAME}"
export NODE_ENV="production"
export PORT="${PORT}"

if [[ ! -f "scripts/create-database.js" ]]; then
  echo "scripts/create-database.js not found in workspace" >&2
  exit 1
fi

if [[ ! -f ".sequelizerc" ]]; then
  echo ".sequelizerc not found in workspace" >&2
  exit 1
fi

echo "==> Creating database if missing: ${DB_NAME}"
node scripts/create-database.js

echo "==> Applying pending Sequelize migrations"
if ! npx sequelize-cli db:migrate; then
  echo "Sequelize migrations failed for ${ENV_NAME}" >&2
  exit 1
fi

echo "==> Restarting PM2 process ${PM2_NAME}"
if command -v pm2 >/dev/null 2>&1; then
  if pm2 show "${PM2_NAME}" >/dev/null 2>&1; then
    pm2 restart "${PM2_NAME}" --update-env
  else
    pm2 start ecosystem.config.js --only "${PM2_NAME}" --update-env
  fi
else
  echo "pm2 is not installed or not on PATH" >&2
  exit 1
fi

for attempt in $(seq 1 20); do
  if curl --fail --silent --show-error "http://127.0.0.1:${PORT}/health" >/tmp/product-api-health.$$ 2>/dev/null; then
    break
  fi
  if [[ "${attempt}" -eq 20 ]]; then
    echo "Health check failed for ${PM2_NAME} on ${PORT}" >&2
    exit 1
  fi
  sleep 3
done

curl --fail --silent --show-error \
  --retry 10 --retry-delay 3 \
  "http://127.0.0.1:${PORT}/api/products" >/dev/null

echo "==> Backend deployment complete for ${ENV_NAME}"
